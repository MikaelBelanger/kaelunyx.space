---
import Layout from "@/layouts/Layout.astro";
import ContactLink from "@/components/ContactLink.astro";
import { socials } from "@/data/socials";

const title = "Contact — Me Kaelunyx Space";
const description =
	"Kaelunyx — artist, developer, and musician. A personal universe shaped by cosmic aesthetics and digital creativity.";
---

<Layout {title} {description} footerBorder={false}>
	<header class="text-center">
		<h1 class="text-cosmic-adaptive-blue my-5 text-3xl">Contact</h1>
		<p class="text-muted-fg mt-3 mb-4">
			Feel free to reach out to me through any of the platforms below:
		</p>
	</header>
	<main class="flex flex-col items-center text-center">
		<nav class="flex flex-col flex-wrap justify-center gap-4 p-3">
			{
				socials.map((category) => (
					<div class="flew-wrap flex flex-col justify-center gap-4">
						<h2 class="text-cosmic-adaptive-purple m-0 basis-full p-0 text-xl">
							{category.category}
						</h2>
						<div class="flex flex-row flex-wrap justify-center gap-4">
							{category.links.map((link, index) => (
								<ContactLink
									href={link.url}
									platform={link.name}
									mirror={index >= category.links.length / 2}
								/>
							))}
						</div>
					</div>
				))
			}
		</nav>
		<a href="/" class="custom-btn page-link mt-2 mb-3">Back to Home</a>
	</main>
</Layout>
